{
  "mcpServers": {
    "ipbuilding-gateway-tools": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "python",
        "-m",
        "ipbuilding_debug"
      ],
      "env": {
        "IPBUILDING_GATEWAY_ADDRESS": "${user_config.gateway_address}"
      }
    }
  }
}
